# LAN / localhost HTTPS with Caddy's local CA (no public DNS required).
# Trust the CA on the host (once), not inside the container:
#   docker compose -f docker-compose.https.yml cp \
#     caddy:/data/caddy/pki/authorities/local/root.crt ./caddy-local-root.crt
{
	http_port {$CADDY_HTTP_PORT:80}
	https_port {$CADDY_HTTPS_PORT:443}
	local_certs
}

{$VAULTBOX_HOSTNAME:localhost} {
	encode gzip
	reverse_proxy vaultbox:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
	tls internal
}
