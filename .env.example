# Copy to .env or let Django create .env on first start.
# Do not commit .env. Changing VAULTBOX_ENCRYPTION_KEY makes existing
# Fernet ciphertext (secrets, seed phrases, wrapped backup passwords)
# undecryptable.

SECRET_KEY=
VAULTBOX_ENCRYPTION_KEY=

# Public hostname for URLs, CORS, CSRF, and WebAuthn RP ID.
# Leave blank for localhost (dev ports 5173 / 8000). Changing this
# invalidates existing passkeys until users re-register.
VAULTBOX_HOSTNAME=
VAULTBOX_USE_HTTPS=false

# Docker / Podman (set on the container, not required in this file for Vite dev):
# VAULTBOX_SINGLE_ORIGIN=true
# VAULTBOX_HTTP_PORT=8000
# VAULTBOX_DEBUG=false
# VAULTBOX_DATA_DIR=/data
# VAULTBOX_ENV_FILE=/data/.env
# VAULTBOX_SEED_DATA=1
#
# Public demo (isolated data dir; never point this at your real DB):
# VAULTBOX_PUBLIC_DEMO=1
# VAULTBOX_DEMO_RESET_SECONDS=1800
# VAULTBOX_DATA_DIR=backend/demo-data
# VAULTBOX_ENV_FILE=backend/demo-data/.env
#
# HTTPS compose (docker-compose.https.yml):
# VAULTBOX_USE_HTTPS=true
# VAULTBOX_HTTP_PORT=443
# CADDY_EMAIL=you@example.com
# CADDYFILE=./deploy/Caddyfile
# Rootless Podman: CADDY_HTTP_PORT=8080 CADDY_HTTPS_PORT=8443 VAULTBOX_HTTP_PORT=8443

